{
  "name": "partiu-ensaio",
  "version": "1.0.0",
  "description": "Aplicativo de agenda musical para ensaios de orquestra",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "generate-icons": "node ./scripts/generate-icons.js",
    "update-theme-colors": "node ./scripts/atualizar-cores-tema.js"
  },
  "keywords": [
    "agenda",
    "musical",
    "orquestra",
    "ensaios"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "sharp": "^0.34.5"
  }
}
